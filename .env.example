# AI Model Providers (Option 1: Free Gemini API key; Option 2: OpenAI/Groq API; Option 3: Leave empty for built-in Heuristic AI Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_AI_PROVIDER=auto

# Database Configuration (SQLite by default, PostgreSQL ready)
DATABASE_URL=sqlite:///./research_agent.db

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Search Settings
MAX_SEARCH_RESULTS_PER_QUERY=4
MAX_FETCH_SOURCES=12
SEARCH_TIMEOUT_SECONDS=10
